{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/v1/cases/:caseId",
      "destination": "/api/case-upload?operation=discard&caseId=:caseId"
    },
    {
      "source": "/api/v1/upload-sessions/:sessionId/files/:field",
      "destination": "/api/case-upload?operation=chunk&sessionId=:sessionId&field=:field"
    },
    {
      "source": "/api/v1/upload-sessions/:sessionId/finalize",
      "destination": "/api/case-upload?operation=finalize&sessionId=:sessionId"
    },
    {
      "source": "/api/v1/upload-sessions/:sessionId",
      "destination": "/api/case-upload?operation=status&sessionId=:sessionId"
    },
    {
      "source": "/api/v1/upload-sessions",
      "destination": "/api/case-upload?operation=create"
    },
    {
      "source": "/api/v1/cases/:caseId/viewer/:path*",
      "destination": "/api/live-viewer?caseId=:caseId&path=:path*"
    },
    {
      "source": "/api/v1/research/runs",
      "destination": "/api/saved-runs?resource=list"
    },
    {
      "source": "/api/v1/runs/:runId",
      "destination": "/api/saved-runs?resource=run&runId=:runId"
    },
    {
      "source": "/qc/mri/metadata",
      "destination": "/api/cortical-qc?resource=metadata"
    },
    {
      "source": "/qc/mri/:kind/:plane/:index",
      "destination": "/api/cortical-qc?resource=image&kind=:kind&plane=:plane&index=:index"
    },
    {
      "source": "/qc/meshes/:filename",
      "destination": "/api/cortical-qc?resource=mesh&filename=:filename"
    },
    {
      "source": "/api/v1/frozen-test/cases/:caseIndex/slices/:plane",
      "destination": "/api/frozen-mri?caseIndex=:caseIndex&plane=:plane"
    },
    {
      "source": "/api/v1/frozen-test/:path*",
      "destination": "https://ksuyamburaj07--neuroprompt3d-real-backend-research-api.us-east.modal.run/api/v1/frozen-test/:path*"
    }
  ],
  "functions": {
    "api/frozen-mri.js": {
      "maxDuration": 60
    },
    "api/cortical-qc.js": {
      "maxDuration": 60
    },
    "api/saved-runs.js": {
      "maxDuration": 60
    },
    "api/live-viewer.js": {
      "maxDuration": 60
    },
    "api/case-upload.js": {
      "maxDuration": 60
    }
  }
}
